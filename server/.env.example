# Server Environment Variables (Template)
PORT=3001
NODE_ENV=development

# Frontend Client URL for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://127.0.0.1:5173
# Optional origins for the browser's Content-Security-Policy connect-src (comma-separated)
CSP_CONNECT_SRC=

# Database Connection
MONGODB_URI=mongodb://localhost:27017/HelloDetective

# Groq AI Service (Get your API key at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Authentication Secrets (Generate secure random strings)
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
